# Copy this file to .env in the project root.
# Do not commit .env.

# ── Build credential boundary ────────────────────────────────────────────────
# A build can embed a copy of this file so the app can read it on any platform.
# Declare what the build is for, or the build stops rather than embed credentials:
#   HOLODECK_CREDENTIAL_MODE=device        headset build: the APK embeds nothing; the
#                                          app reads the .env that lives on the device at
#                                          /sdcard/Android/data/<package>/files/.env
#                                          (Application.persistentDataPath/.env).
#   HOLODECK_CREDENTIAL_MODE=private       private developer build: every entry is
#                                          embedded; never share the artifact.
#   HOLODECK_CREDENTIAL_MODE=distribution  shareable build: only the non-secret
#                                          BASE_URL / search URL entries are embedded.
# You can set this here, or pass -credentialMode device|private|distribution on the
# build command line, or pick "Headset Holodeck > Build Credentials" in the Unity menu.
# HOLODECK_CREDENTIAL_MODE=device
#
# For a device build, copy this file to the headset once per device:
#   adb push .env /sdcard/Android/data/com.QLC.HeadsetHolodeck/files/.env

# Required for the main World Labs + OpenAI voice command flow.
OPENAI_API_KEY=
WORLDLABS_API_KEY=

# Optional image search.
PIXABAY_API_KEY=

# Optional audio search providers.
FREESOUND_API_KEY=
XENO_CANTO_API_KEY=

# Optional object-generation integrations.
MESHY_API_KEY=
TRIPO_API_KEY=
THREEDAISTUDIO_API_KEY=
THREEDAISTUDIO_BASE_URL=https://api.3daistudio.com
HITEM_ACCESS_KEY=
HITEM_SECRET_KEY=
HITEM_BASE_URL=https://api.hitem3d.ai

# Optional endpoint overrides for local/proxy testing.
# These are configuration, not credentials: they are the only entries a
# distribution build embeds. Never put a key or token in a *_URL entry.
FREESOUND_SEARCH_URL=
XENO_CANTO_SEARCH_URL=
OPENVERSE_AUDIO_SEARCH_URL=
